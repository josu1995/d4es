---
import '../styles/global.css';
import { loadEstado, diasHastaFinDeTemporada } from '../lib/data';

interface Props {
  titulo: string;
  descripcion: string;
  noindex?: boolean;
  /** Migas de pan para los datos estructurados: [{nombre, url}]. */
  migas?: { nombre: string; url: string }[];
}

const { titulo, descripcion, noindex = false, migas = [] } = Astro.props;
const estado = loadEstado();
const dias = diasHastaFinDeTemporada(estado, new Date());
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://d4es.netlify.app');

const nav = [
  { href: '/builds', texto: 'Builds' },
  { href: '/meta', texto: 'Meta' },
  { href: '/guias', texto: 'Guías' },
  { href: '/objetos', texto: 'Objetos' },
  { href: '/glosario', texto: 'Glosario' },
  { href: '/buscar', texto: 'Buscar' },
];
---

<!doctype html>
<html lang="es-ES">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Cambios en D4es" href="/rss.xml" />
    {
      migas.length > 0 && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            itemListElement: migas.map((m, i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name: m.nombre,
              item: new URL(m.url, canonical).href,
            })),
          })}
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-piedra focus:px-4 focus:py-2 focus:grabado"
    >
      Saltar al contenido
    </a>

    <header class="border-b border-grabado bg-abismo/85 backdrop-blur sticky top-0 z-40">
      <div class="mx-auto max-w-6xl px-4 h-14 flex items-center gap-6">
        <a href="/" class="font-titulo text-lg tracking-tight shrink-0">
          <span class="text-brasa-viva">D4</span><span class="text-pergamino">es</span>
        </a>
        <nav aria-label="Principal" class="flex items-center gap-5 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="text-ceniza hover:text-pergamino transition-colors"
                aria-current={Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}
              >
                {item.texto}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto text-xs text-humo hidden sm:block">
          Temporada {estado.temporadaActual} · Parche {estado.parche}
        </div>
      </div>
    </header>

    {
      dias <= 0 && (
        <div class="bg-brasa/15 border-b border-brasa/40 text-sm">
          <div class="mx-auto max-w-6xl px-4 py-2 text-pergamino">
            <strong>Aviso:</strong> la temporada {estado.temporadaActual} ya debería haber terminado según la
            fecha prevista ({estado.finPrevisto}). Los datos pueden estar desfasados hasta que se ejecute el
            corte de temporada.
          </div>
        </div>
      )
    }

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-grabado mt-16">
      <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-humo space-y-3">
        <p>
          Diablo IV es propiedad de Blizzard Entertainment. Este es un sitio de fans sin ánimo de lucro y
          <strong>no está afiliado ni respaldado por Blizzard</strong>.
        </p>
        <p>
          Las builds se recogen de sus autores originales y cada ficha enlaza a la fuente. Los nombres en
          castellano proceden de la localización oficial del juego vía
          <a class="text-ceniza hover:text-pergamino underline" href="/creditos">Diablo4Companion (MIT)</a>.
        </p>
        <p class="flex gap-4">
          <a class="hover:text-pergamino" href="/creditos">Créditos y fuentes</a>
          <a class="hover:text-pergamino" href="/estado">Estado de los datos</a>
        </p>
      </div>
    </footer>
  </body>
</html>
