---
import Base from '../../../layouts/Base.astro';
import { loadContenido, texto, unicoEnCastellano } from '../../../lib/contenido';
import { slugify, type Jefe } from '@d4es/schema';

export function getStaticPaths() {
  return loadContenido().jefes.map((jefe) => ({ params: { id: jefe.id }, props: { jefe } }));
}

interface Props {
  jefe: Jefe;
}

const { jefe } = Astro.props;
const { llaves, jefes } = loadContenido();
const llave = jefe.llaveRequerida ? llaves.find((l) => l.id === jefe.llaveRequerida) : null;
const llaveSuelta = jefe.sueltaLlave ? llaves.find((l) => l.id === jefe.sueltaLlave) : null;

const ETIQUETA_TIER: Record<string, string> = {
  initiate: 'Jefe inicial',
  greater: 'Jefe mayor',
  exalted: 'Exaltado',
  estacional: 'De temporada',
};

// Con qué jefe seguir: los que se abren con la llave que este suelta.
const siguientes = llaveSuelta ? jefes.filter((j) => j.llaveRequerida === llaveSuelta.id) : [];
---

<Base
  titulo={`${texto(jefe.nombre)}: llave, ubicación y qué suelta — Diablo 4`}
  descripcion={`Cómo hacer a ${texto(jefe.nombre)} en Diablo 4: qué llave necesita, dónde está y qué únicos suelta. Temporada 14.`}
>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <nav aria-label="Migas de pan" class="text-xs text-humo">
      <a href="/guias" class="hover:text-pergamino">Guías</a>
      <span> / </span>
      <a href="/guias/jefes" class="hover:text-pergamino">Jefes</a>
    </nav>

    <header class="mt-3">
      <p class="text-xs uppercase tracking-[0.2em] text-oro-apagado">{ETIQUETA_TIER[jefe.tier]}</p>
      <h1 class="mt-1 font-titulo text-3xl sm:text-4xl">{texto(jefe.nombre)}</h1>
      {
        jefe.nombre.es && jefe.nombre.es !== jefe.nombre.en && (
          <p class="mt-1 text-sm text-humo">
            En inglés: <span class="text-ceniza">{jefe.nombre.en}</span>
          </p>
        )
      }
      {jefe.ubicacion && <p class="mt-2 text-sm text-ceniza">{jefe.ubicacion}</p>}
    </header>

    <section class="mt-8 grabado rounded-lg bg-piedra p-5">
      <h2 class="font-titulo text-xl">Cómo se hace</h2>
      <ol class="mt-3 space-y-3 text-sm">
        <li class="flex gap-3">
          <span class="font-mono text-oro shrink-0">1</span>
          <span class="text-ceniza">
            <strong class="text-pergamino">Lo matas primero.</strong> Desde Lord of Hatred no hay invocación
            previa: entras y peleas.
          </span>
        </li>
        <li class="flex gap-3">
          <span class="font-mono text-oro shrink-0">2</span>
          <span class="text-ceniza">
            <strong class="text-pergamino">Después gastas la llave</strong> para abrir el alijo que aparece.
            {llave && <> Necesitas <strong class="text-pergamino">{texto(llave.nombre)}</strong>.</>}
            {!llave && <> La llave exacta que pide está sin confirmar.</>}
          </span>
        </li>
        {
          llaveSuelta && (
            <li class="flex gap-3">
              <span class="font-mono text-oro shrink-0">3</span>
              <span class="text-ceniza">
                <strong class="text-pergamino">Te llevas {texto(llaveSuelta.nombre)}</strong>, que es lo que
                abre el escalón siguiente.
              </span>
            </li>
          )
        }
      </ol>
    </section>

    {
      llave && (
        <section class="mt-4 grabado rounded-lg bg-piedra p-5">
          <h2 class="font-titulo text-xl">Dónde conseguir {texto(llave.nombre)}</h2>
          <ul class="mt-3 space-y-1.5 text-sm text-ceniza">
            {llave.seObtieneEn.map((f) => (
              <li class="flex gap-2">
                <span class="text-humo">·</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      jefe.unicos.length > 0 && (
        <section class="mt-4 grabado rounded-lg bg-piedra p-5">
          <h2 class="font-titulo text-xl">Únicos que suelta</h2>
          <p class="mt-1 text-xs text-humo">
            Son sus únicos «firma», no la tabla completa: eso está pendiente de contrastar dentro del juego.
          </p>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {jefe.unicos.map((u) => (
              <li>
                <a
                  href={`/objetos/unicos/${slugify(u)}`}
                  class="grabado grabado-hover flex items-center justify-between rounded bg-abismo px-3 py-2 text-sm"
                >
                  <span class="text-rareza-unico">{unicoEnCastellano(u)}</span>
                  <span class="text-humo">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      jefe.notas.length > 0 && (
        <section class="mt-4 grabado rounded-lg bg-piedra p-5">
          <h2 class="font-titulo text-xl">A tener en cuenta</h2>
          <ul class="mt-3 space-y-2 text-sm text-ceniza">
            {jefe.notas.map((n) => (
              <li class="flex gap-2">
                <span class="text-humo">·</span>
                <span>{n}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      siguientes.length > 0 && (
        <section class="mt-4">
          <h2 class="font-titulo text-xl">Y con esa llave, a por</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {siguientes.map((s) => (
              <a
                href={`/guias/jefes/${s.id}`}
                class="grabado grabado-hover rounded bg-piedra px-3 py-2 text-sm"
              >
                {texto(s.nombre)} →
              </a>
            ))}
          </div>
        </section>
      )
    }

    <aside class="mt-8 grabado rounded-lg border-oro-apagado/40 bg-oro/5 p-4 text-sm">
      <p class="text-pergamino"><strong>Estado de estos datos.</strong></p>
      <p class="mt-1.5 text-ceniza">
        Contrastados entre varias fuentes de la comunidad, pero <strong>no verificados de primera mano</strong>
        dentro del juego. Fuente: {jefe.verificacion.fuente}. Parche {jefe.verificacion.parche}.
      </p>
    </aside>
  </article>
</Base>
