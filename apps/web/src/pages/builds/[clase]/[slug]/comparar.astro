---
import Base from '../../../../layouts/Base.astro';
import { loadBuilds, loadClasesEs, claseNombre } from '../../../../lib/data';
import { classById, computeDiff, type CanonicalBuild } from '@d4es/schema';

export function getStaticPaths() {
  return loadBuilds()
    // Comparar una build consigo misma no tiene sentido.
    .filter((build) => build.variants.length > 1)
    .map((build) => ({
      params: { clase: classById(build.classId)?.slug ?? build.classId, slug: build.id },
      props: { build },
    }));
}

interface Props {
  build: CanonicalBuild;
}

const { build } = Astro.props;
const clasesEs = loadClasesEs();
const nombreClase = claseNombre(build.classId, clasesEs);

const a = build.variants[0]!;
const b = build.variants[1]!;
const secciones = computeDiff(a, b);

const TITULO_SECCION: Record<string, string> = {
  skills: 'Habilidades',
  gear: 'Objetos únicos',
  paragon: 'Glifos',
};

const etiqueta = (v: (typeof build.variants)[number]) =>
  v.source.variantLabel ?? `Variante ${v.source.variantIndex + 1}`;

const totalFilas = secciones.reduce((n, s) => n + s.rows.length, 0);

function valor(fila: { values: Record<string, string | number | null> }, id: string): string {
  const v = fila.values[id];
  if (v === null || v === undefined) return '—';
  return v === 'si' ? '✓' : String(v);
}
---

<Base
  titulo={`${build.title.es}: en qué se diferencian sus variantes — Diablo 4`}
  descripcion={`Comparación lado a lado de las variantes de la build ${build.title.es} de ${nombreClase}: qué cambia en habilidades, objetos y glifos.`}
>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <nav aria-label="Migas de pan" class="text-xs text-humo">
      <a href="/builds" class="hover:text-pergamino">Builds</a>
      <span> / </span>
      <a href={`/builds/${classById(build.classId)?.slug}/${build.id}`} class="hover:text-pergamino">
        {build.title.es}
      </a>
    </nav>

    <h1 class="mt-3 font-titulo text-3xl">En qué se diferencian</h1>
    <p class="mt-3 max-w-2xl text-ceniza leading-relaxed">
      Las dos versiones de <strong class="text-pergamino">{build.title.es}</strong> se muestran tal cual las
      publica su autor: <strong class="text-pergamino">no se mezclan ni se promedian</strong>. Abajo solo
      aparece lo que cambia; todo lo que no sale es porque coinciden.
    </p>

    <div class="mt-6 grabado rounded-lg bg-piedra overflow-hidden">
      <table class="w-full text-sm">
        <caption class="sr-only">Diferencias entre las variantes de la build</caption>
        <thead>
          <tr class="border-b border-grabado bg-piedra-alta">
            <th scope="col" class="px-4 py-3 text-left font-normal text-humo">Qué</th>
            <th scope="col" class="px-4 py-3 text-left font-titulo text-pergamino">{etiqueta(a)}</th>
            <th scope="col" class="px-4 py-3 text-left font-titulo text-pergamino">{etiqueta(b)}</th>
          </tr>
        </thead>
        <tbody>
          {
            totalFilas === 0 ? (
              <tr>
                <td colspan="3" class="px-4 py-8 text-center text-ceniza">
                  Estas dos variantes son idénticas en habilidades, objetos únicos y glifos.
                </td>
              </tr>
            ) : (
              secciones
                .filter((s) => s.rows.length > 0)
                .flatMap((s) => [
                  <tr class="border-b border-grabado bg-abismo/60">
                    <th
                      colspan="3"
                      scope="colgroup"
                      class="px-4 py-2 text-left text-xs uppercase tracking-wider text-oro-apagado"
                    >
                      {TITULO_SECCION[s.section] ?? s.section}
                    </th>
                  </tr>,
                  ...s.rows.map((fila) => (
                    <tr class="border-b border-grabado/60">
                      <td class="px-4 py-2.5">
                        <span class="text-pergamino">
                          {fila.label ? (fila.label.esES ?? fila.label.enUS) : fila.key}
                        </span>
                        {fila.label?.esES === null && <span class="chip-en" data-i18n-missing>EN</span>}
                        <span
                          class:list={[
                            'ml-2 rounded px-1.5 py-0.5 text-[0.6rem] uppercase tracking-wider',
                            fila.status === 'differ'
                              ? 'border border-brasa/50 text-brasa-viva'
                              : 'border border-grabado text-humo',
                          ]}
                        >
                          {fila.status === 'differ' ? 'cambia' : 'solo en una'}
                        </span>
                      </td>
                      <td class="px-4 py-2.5 font-mono text-ceniza">{valor(fila, a.id)}</td>
                      <td class="px-4 py-2.5 font-mono text-ceniza">{valor(fila, b.id)}</td>
                    </tr>
                  )),
                ])
            )
          }
        </tbody>
      </table>
    </div>

    {
      build.consensus.coreSkills.length > 0 && (
        <section class="mt-6 grabado rounded-lg bg-piedra p-5">
          <h2 class="font-titulo text-xl">En lo que sí coinciden</h2>
          <p class="mt-1 text-sm text-ceniza">
            Estas habilidades están en las dos versiones: son el núcleo de la build, lo que no debes tocar.
          </p>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {build.consensus.coreSkills.map((s) => (
              <li class="rounded border border-grabado bg-abismo px-2 py-1 text-sm text-ceniza">
                {s.esES ?? s.enUS}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <a
      href={`/builds/${classById(build.classId)?.slug}/${build.id}`}
      class="mt-8 inline-block text-sm text-ceniza underline underline-offset-4 hover:text-pergamino"
    >
      ← Volver a la build
    </a>
  </div>
</Base>
