---
import Base from '../../../layouts/Base.astro';
import SlotSkill from '../../../components/SlotSkill.astro';
import SlotEquipo from '../../../components/SlotEquipo.astro';
import ArbolHabilidades from '../../../components/ArbolHabilidades.astro';
import Termino from '../../../components/Termino.astro';
import ArbolPlanGuerra from '../../../components/ArbolPlanGuerra.astro';
import TableroParagon from '../../../components/TableroParagon.astro';
import ListaCambios from '../../../components/ListaCambios.astro';
import Progreso from '../../../components/Progreso.astro';
import {
  loadBuilds,
  loadClasesEs,
  claseNombre,
  skillInfo,
  layoutPlan,
  layoutTablero,
  historialDeBuild,
  loadHistorial,
} from '../../../lib/data';
import { iconoClase, iconoActividadPlan, iconoSkill } from '../../../lib/iconos';
import { NOMBRE_SLOT, capitalizar } from '../../../lib/etiquetas';
import {
  MAX_WARPLAN_POINTS,
  classById,
  type CanonicalBuild,
  type GearItem,
  type SlotId,
} from '@d4es/schema';

export function getStaticPaths() {
  return loadBuilds().map((build) => ({
    params: { clase: classById(build.classId)?.slug ?? build.classId, slug: build.id },
    props: { build },
  }));
}

interface Props {
  build: CanonicalBuild;
}

const { build } = Astro.props;
const clasesEs = loadClasesEs();
const nombreClase = claseNombre(build.classId, clasesEs);
const claseSlug = classById(build.classId)?.slug ?? build.classId;

// El historial arranca el día que se empezó a registrar: antes de eso hay foto, no película.
const cambios = historialDeBuild(build.id);
const registrandoDesde = (() => {
  const desde = loadHistorial()?.desde;
  return desde
    ? `desde el ${new Date(desde).toLocaleDateString('es-ES', { day: 'numeric', month: 'long' })}`
    : 'desde hace poco';
})();

const principal = build.variants.find((v) => v.id === build.primaryVariantId) ?? build.variants[0]!;
const hayVariasFuentes = build.variants.length > 1;

const COLOR_TIER: Record<string, string> = {
  S: 'text-rareza-mitico border-rareza-mitico/60',
  A: 'text-rareza-legendario border-rareza-legendario/60',
  B: 'text-rareza-raro border-rareza-raro/50',
  C: 'text-rareza-magico border-rareza-magico/50',
};
const tierClase = build.ratings.tierLabel ? (COLOR_TIER[build.ratings.tierLabel[0] ?? ''] ?? '') : '';

const fechaCaptura = new Date(principal.source.capturedAt).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// El muñeco de equipo se reparte en dos columnas, como en el juego.
const COLUMNA_IZQUIERDA: SlotId[] = ['helm', 'chest', 'gloves', 'pants', 'boots'];
const COLUMNA_DERECHA: SlotId[] = ['amulet', 'ring1', 'ring2', 'weapon', 'offhand', 'weapon2', 'weapon3', 'weapon4'];

function repartir(gear: Record<string, GearItem>) {
  const izq = COLUMNA_IZQUIERDA.map((s) => gear[s]).filter((x): x is GearItem => Boolean(x));
  const der = COLUMNA_DERECHA.map((s) => gear[s]).filter((x): x is GearItem => Boolean(x));
  return { izq, der };
}

/**
 * Las pestañas son las mismas que publica d4builds. "Notas" enlaza al original en vez de
 * copiar su contenido: ese texto es el trabajo del autor de la guía, no nuestro.
 */
const PESTANAS = [
  { id: 'equipo', etiqueta: 'Equipo y habilidades' },
  { id: 'arbol', etiqueta: 'Árbol de habilidades' },
  { id: 'paragon', etiqueta: 'Paragón' },
  { id: 'mercenarios', etiqueta: 'Mercenarios' },
  { id: 'warplans', etiqueta: 'Planes de guerra' },
  { id: 'progreso', etiqueta: 'Qué me falta' },
  { id: 'cambios', etiqueta: 'Cambios' },
  { id: 'notas', etiqueta: 'Notas del autor' },
] as const;

function disponible(v: (typeof build.variants)[number], id: string): boolean {
  switch (id) {
    case 'equipo':
      return v.completeness.hasGear || v.skills.length > 0;
    case 'arbol':
      return v.skills.length > 0;
    case 'paragon':
      return v.paragon.boards.length > 0;
    case 'mercenarios':
      return v.mercenary !== null;
    case 'warplans':
      return v.warPlan !== null;
    default:
      return true;
  }
}
---

<Base
  titulo={`${build.title.es} — ${nombreClase} · Build de Diablo 4 en español`}
  descripcion={`Build de ${nombreClase} "${build.title.es}" para Diablo 4 temporada ${build.gameVersion.season}: equipo, aspectos, Paragón y habilidades, en castellano.`}
>
  <div class="mx-auto max-w-5xl px-4 py-8">
    <nav aria-label="Migas de pan" class="text-xs text-humo">
      <a href="/builds" class="hover:text-pergamino">Builds</a>
      <span> / </span>
      <a href={`/builds?clase=${classById(build.classId)?.slug}`} class="hover:text-pergamino">{nombreClase}</a>
    </nav>

    <header class="mt-4 grabado rounded-xl bg-piedra overflow-hidden">
      <div class="flex items-center gap-5 p-5 sm:p-6 bg-gradient-to-r from-brasa/10 via-transparent to-transparent">
        <img
          src={iconoClase(build.classId)}
          alt=""
          width="88"
          height="88"
          class="h-20 w-20 shrink-0 rounded-lg border border-grabado-vivo bg-abismo object-cover"
          onerror="this.style.display='none'"
        />
        <div class="min-w-0">
          <h1 class="font-titulo text-3xl sm:text-4xl leading-tight">{build.title.es}</h1>
          <p class="mt-1 text-sm text-ceniza">
            {nombreClase}
            {principal.source.author && <span class="text-humo"> · por {principal.source.author}</span>}
            {build.title.es !== build.title.en && <span class="text-humo"> · «{build.title.en}»</span>}
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
            {build.ratings.tierLabel && (
              <span class={`rounded border bg-abismo px-2 py-1 font-semibold ${tierClase}`}>
                Tier {build.ratings.tierLabel}
              </span>
            )}
            {build.ratings.pitTier && (
              <span class="rounded border border-grabado bg-abismo px-2 py-1 text-ceniza">
                Fosa {build.ratings.pitTier}
              </span>
            )}
            <span class="rounded border border-grabado bg-abismo px-2 py-1 text-ceniza">
              {principal.levelBand === 'leveling' ? 'Subida de nivel' : 'Endgame'}
            </span>
            <span class="rounded border border-grabado bg-abismo px-2 py-1 text-humo">
              T{build.gameVersion.season} · {build.gameVersion.patch}
            </span>
          </div>
        </div>
      </div>

      {
        hayVariasFuentes && (
          <div class="border-t border-grabado px-5 py-3">
            <span class="text-xs uppercase tracking-wider text-humo mr-3">Versión:</span>
            <div class="inline-flex flex-wrap gap-2" role="tablist" aria-label="Variante de la build">
              {build.variants.map((v) => (
                <button
                  type="button"
                  role="tab"
                  data-variante={v.id}
                  aria-selected={v.id === build.primaryVariantId}
                  class="grabado grabado-hover rounded bg-abismo px-3 py-1.5 text-sm aria-selected:border-brasa/60 aria-selected:bg-brasa/15"
                >
                  {v.source.variantLabel ?? `Variante ${v.source.variantIndex + 1}`}
                </button>
              ))}
            </div>
            <a
              href={`${Astro.url.pathname}/comparar`}
              class="ml-3 text-sm text-ceniza underline underline-offset-4 hover:text-pergamino"
            >
              Comparar →
            </a>
          </div>
        )
      }
    </header>

    <div class="mt-6 flex flex-wrap gap-1 border-b border-grabado" role="tablist" aria-label="Secciones">
      {
        PESTANAS.map((p, i) => (
          <button
            type="button"
            role="tab"
            aria-selected={i === 0}
            data-pestana={p.id}
            class="rounded-t px-3.5 py-2.5 text-sm text-ceniza transition-colors hover:text-pergamino aria-selected:text-pergamino aria-selected:bg-piedra grabado border-transparent aria-selected:border-b-transparent"
          >
            {p.etiqueta}
          </button>
        ))
      }
    </div>

    {
      build.variants.map((v) => {
        const { izq, der } = repartir(v.gear);
        const idBase = `v${v.source.variantIndex}`;
        return (
          <div data-panel-variante={v.id} class:list={[v.id !== build.primaryVariantId && 'hidden']}>
            {/* EQUIPO Y HABILIDADES */}
            <section
              data-panel-pestana="equipo"
              class="grabado rounded-b-lg rounded-tr-lg bg-piedra p-5 sm:p-6"
            >
              {izq.length + der.length > 0 ? (
                <>
                  <h2 class="font-titulo text-xl">Equipo</h2>
                  <div class="mt-4 grid gap-x-8 gap-y-5 sm:grid-cols-2">
                    <div class="space-y-5">
                      {izq.map((item, i) => (
                        <SlotEquipo item={item} idTooltip={`${idBase}-gi-${i}`} />
                      ))}
                    </div>
                    <div class="space-y-5">
                      {der.map((item, i) => (
                        <SlotEquipo item={item} idTooltip={`${idBase}-gd-${i}`} derecha />
                      ))}
                    </div>
                  </div>
                  <p class="mt-4 text-xs text-humo">
                    <span class="text-oro">★</span> afijo superior · <span class="text-rareza-magico">azul</span>{' '}
                    afijo templado · <span class="inline-block h-2 w-2 rotate-45 border border-oro-apagado/70 align-middle" />{' '}
                    engarce
                  </p>

                  {/* Las "Gear Stats" de d4builds: la lista priorizada de afijos por pieza.
                      El orden es el de la fuente, y ES la prioridad. */}
                  {[...izq, ...der].some((it) => it.affixes.length > 0) && (
                    <>
                      <h3 class="mt-8 font-titulo text-lg">Prioridad de afijos por pieza</h3>
                      <p class="mt-1 text-xs text-humo">
                        En el orden que publica la guía: lo primero de cada lista es lo que hay que
                        buscar primero al elegir o templar la pieza.
                      </p>
                      <div class="mt-3 grid gap-3 sm:grid-cols-2">
                        {[...izq, ...der]
                          .filter((it) => it.affixes.length > 0)
                          .map((it) => (
                            <div class="grabado rounded bg-abismo p-3">
                              <p class="text-[0.65rem] uppercase tracking-wider text-humo">
                                {NOMBRE_SLOT[it.slot] ?? it.slot}
                              </p>
                              <ol class="mt-1.5 space-y-1">
                                {it.affixes.map((a, j) => (
                                  <li class="flex gap-2 text-xs leading-snug text-ceniza">
                                    <span class="w-4 shrink-0 text-right font-mono text-humo">{j + 1}</span>
                                    <span>
                                      {a.greater && (
                                        <span class="text-oro" title="Afijo superior">
                                          ★{' '}
                                        </span>
                                      )}
                                      <span class={a.tempered ? 'text-rareza-magico' : ''}>
                                        {capitalizar(a.ref.esES ?? a.ref.enUS)}
                                      </span>
                                      {a.ref.esES === null && (
                                        <span class="chip-en" data-i18n-missing>
                                          EN
                                        </span>
                                      )}
                                      {a.tempered && (
                                        <span class="text-humo" title="Afijo templado">
                                          {' '}
                                          ⚒
                                        </span>
                                      )}
                                    </span>
                                  </li>
                                ))}
                              </ol>
                            </div>
                          ))}
                      </div>
                    </>
                  )}
                </>
              ) : (
                <div class="rounded border border-oro-apagado/40 bg-oro/5 p-4 text-sm">
                  <p class="text-pergamino"><strong>El equipo de esta build todavía no está extraído.</strong></p>
                  <p class="mt-1.5 text-ceniza">
                    Se saca página a página con un navegador y va por lotes; esta build aún no ha entrado.
                    Mientras tanto lo tienes íntegro en la guía original.
                  </p>
                </div>
              )}

              {v.skills.length > 0 && (
                <>
                  <h2 class="mt-8 font-titulo text-xl">Habilidades</h2>
                  <p class="mt-1 text-xs text-humo">
                    Pasa el ratón por encima para ver qué hace cada una y las mejoras de rama elegidas.
                  </p>
                  <div class="mt-4 flex flex-wrap justify-center gap-x-4 gap-y-6 sm:justify-start">
                    {v.skills.map((s, i) => (
                      <SlotSkill skill={s} idTooltip={`${idBase}-sk-${i}`} />
                    ))}
                  </div>
                </>
              )}
            </section>

            {/* ARBOL */}
            <section
              data-panel-pestana="arbol"
              class="hidden grabado rounded-b-lg rounded-tr-lg bg-piedra p-5 sm:p-6"
            >
              <h2 class="font-titulo text-xl">Árbol de habilidades</h2>
              {v.skills.length > 0 ? (
                <ArbolHabilidades
                  claseEnUS={classById(build.classId)?.enUS ?? ''}
                  asignadas={v.skills}
                  idBase={`v${v.source.variantIndex}`}
                />
              ) : (
                <p class="mt-2 text-ceniza">Esta variante no publica el árbol.</p>
              )}
            </section>

            {/* PARAGON */}
            <section
              data-panel-pestana="paragon"
              class="hidden grabado rounded-b-lg rounded-tr-lg bg-piedra p-5 sm:p-6"
            >
              <h2 class="font-titulo text-xl">
                Tableros de Paragón
                {v.paragon.level !== null && (
                  <span class="ml-2 align-middle font-sans text-sm font-normal text-humo">
                    nivel {v.paragon.level}
                  </span>
                )}
              </h2>
              {v.paragon.boards.length > 0 ? (
                <>
                  <p class="mt-1 text-sm text-ceniza">
                    En el orden en que se encajan, con el glifo de cada uno. Despliega un tablero para
                    ver el camino que recorre la build. Recuerda que los glifos solo suben en la Fosa
                    y que el salto importante está en el nivel 51.
                  </p>
                  <ol class="mt-4 space-y-2">
                    {v.paragon.boards.map((b, i) => {
                      const forma = layoutTablero(claseSlug, b.ref.enUS);
                      // "Starting Board" es un rotulo de la fuente, no el nombre del tablero en
                      // el juego (cada clase tiene el suyo y d4builds no lo publica): se compone
                      // en la interfaz, como los skillVariant.
                      const esInicial = b.ref.enUS === 'Starting Board';
                      const nombreTablero = esInicial ? 'Tablero inicial' : (b.ref.esES ?? b.ref.enUS);
                      const glifoNombre = b.glyph ? (b.glyph.ref.esES ?? b.glyph.ref.enUS) : null;
                      return (
                        <li class="grabado rounded bg-abismo">
                          <details open={i === 0}>
                            <summary class="flex cursor-pointer flex-wrap items-center gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden">
                              <span class="font-mono text-sm text-humo">{i + 1}</span>
                              <span class="text-pergamino">
                                {nombreTablero}
                                {!esInicial && b.ref.esES === null && (
                                  <span class="chip-en" data-i18n-missing>EN</span>
                                )}
                              </span>
                              {b.rotation !== null && b.rotation !== 0 && (
                                <span class="text-xs text-humo" title="Giro con que se encaja el tablero">
                                  ⟳ {b.rotation}°
                                </span>
                              )}
                              {glifoNombre && (
                                <span class="ml-auto flex items-center gap-2 text-sm">
                                  <span class="inline-block h-2 w-2 rotate-45 border border-oro bg-oro/20" />
                                  <span class="text-oro">
                                    {glifoNombre}
                                    {b.glyph!.ref.esES === null && (
                                      <span class="chip-en" data-i18n-missing>EN</span>
                                    )}
                                  </span>
                                  {b.glyph!.rank !== null && (
                                    <span class="rounded border border-grabado px-1.5 py-0.5 font-mono text-xs text-ceniza">
                                      {b.glyph!.rank}
                                    </span>
                                  )}
                                </span>
                              )}
                              <span class="text-humo" aria-hidden="true">▾</span>
                            </summary>
                            {forma ? (
                              <div class="border-t border-grabado px-4 pb-4">
                                <TableroParagon
                                  layout={forma}
                                  rotation={b.rotation}
                                  tiles={new Set(b.tiles)}
                                  glifo={glifoNombre}
                                  idBase={`${idBase}-pb${i}`}
                                />
                                {b.tiles.length > 0 && (
                                  <p class="text-center text-xs text-humo">
                                    {b.tiles.length} casillas recorridas
                                  </p>
                                )}
                              </div>
                            ) : (
                              <p class="border-t border-grabado px-4 py-3 text-sm text-ceniza">
                                La forma de este tablero todavía no está extraída; de momento, solo el
                                nombre y el glifo.
                              </p>
                            )}
                          </details>
                        </li>
                      );
                    })}
                  </ol>
                  <p class="mt-4 text-xs text-humo">
                    <span class="inline-block h-2.5 w-2.5 rounded-sm border-2 border-brasa-viva bg-brasa/35 align-middle" />{' '}
                    camino de la build ·{' '}
                    <span class="inline-block h-2.5 w-2.5 rounded-sm border-2 border-rareza-magico align-middle" />{' '}
                    casilla mágica ·{' '}
                    <span class="inline-block h-2.5 w-2.5 rounded-sm border-2 border-rareza-raro align-middle" />{' '}
                    rara ·{' '}
                    <span class="inline-block h-2.5 w-2.5 rounded-sm border-2 border-rareza-legendario align-middle" />{' '}
                    legendaria ·{' '}
                    <span class="inline-block h-2.5 w-2.5 rotate-45 border border-oro bg-oro/20 align-middle" />{' '}
                    engarce de glifo
                  </p>
                </>
              ) : (
                <p class="mt-2 text-ceniza">
                  Los tableros de esta build todavía no están extraídos.
                </p>
              )}
            </section>

            {/* MERCENARIOS */}
            <section
              data-panel-pestana="mercenarios"
              class="hidden grabado rounded-b-lg rounded-tr-lg bg-piedra p-5 sm:p-6"
            >
              <h2 class="font-titulo text-xl">Mercenarios</h2>
              {v.mercenary ? (
                <div class="mt-3 space-y-3">
                  <div class="grabado rounded bg-abismo p-4">
                    <p class="text-xs uppercase tracking-wider text-humo">Contratado</p>
                    <p class="mt-1 text-lg text-pergamino">
                      {v.mercenary.ref.esES ?? v.mercenary.ref.enUS}
                      {v.mercenary.ref.esES === null && (
                        <span class="chip-en" data-i18n-missing>EN</span>
                      )}
                    </p>
                    {v.mercenary.skills.length > 0 && (
                      <>
                        <p class="mt-3 text-xs uppercase tracking-wider text-humo">
                          Habilidades elegidas
                        </p>
                        <ul class="mt-1.5 flex flex-wrap gap-1.5">
                          {v.mercenary.skills.map((s) => {
                            const info = skillInfo(s.enUS);
                            return (
                              <li
                                class="flex items-center gap-1.5 rounded border border-grabado px-2 py-1 text-xs text-ceniza"
                                title={info?.description ?? undefined}
                              >
                                <img
                                  src={iconoSkill(s.enUS)}
                                  alt=""
                                  width="20"
                                  height="20"
                                  loading="lazy"
                                  class="h-5 w-5 rounded-sm"
                                  onerror="this.style.display='none'"
                                />
                                {s.esES ?? s.enUS}
                                {s.esES === null && (
                                  <span class="chip-en" data-i18n-missing>EN</span>
                                )}
                              </li>
                            );
                          })}
                        </ul>
                      </>
                    )}
                  </div>
                  {v.mercenary.reinforcement && (
                    <div class="grabado rounded bg-abismo p-4">
                      <p class="text-xs uppercase tracking-wider text-humo">Refuerzo</p>
                      <p class="mt-1 text-lg text-pergamino">
                        {v.mercenary.reinforcement.esES ?? v.mercenary.reinforcement.enUS}
                        {v.mercenary.reinforcement.esES === null && (
                          <span class="chip-en" data-i18n-missing>EN</span>
                        )}
                      </p>
                    </div>
                  )}
                </div>
              ) : (
                <p class="mt-2 text-ceniza">Esta build no lleva mercenario, o todavía no está extraído.</p>
              )}
            </section>

            {/* PLANES DE GUERRA */}
            <section
              data-panel-pestana="warplans"
              class="hidden grabado rounded-b-lg rounded-tr-lg bg-piedra p-5 sm:p-6"
            >
              <h2 class="font-titulo text-xl">Planes de guerra</h2>
              {v.warPlan && v.warPlan.activities.length > 0 ? (
                <>
                  <p class="mt-1 text-sm text-ceniza max-w-2xl">
                    Cada actividad tiene su propio plan con {MAX_WARPLAN_POINTS} puntos independientes:
                    lo que gastes en la Fosa no te lo quita de los Susurros. Aquí van los nodos que
                    esta build invierte en cada una.
                  </p>
                  {/* Una pestañita por actividad, como en el juego: siete árboles apilados
                      obligaban a bajar media pantalla para ver el segundo. */}
                  <div
                    class="mt-4 flex flex-wrap gap-1.5"
                    role="tablist"
                    aria-label="Actividad del plan de guerra"
                  >
                    {v.warPlan.activities.map((a, i) => (
                      <button
                        type="button"
                        role="tab"
                        aria-selected={i === 0}
                        data-plan={`${idBase}-${a.slug}`}
                        class="grabado grabado-hover flex items-center gap-1.5 rounded bg-abismo px-2.5 py-1.5 text-xs text-ceniza aria-selected:border-brasa/60 aria-selected:bg-brasa/15 aria-selected:text-pergamino"
                      >
                        <img
                          src={iconoActividadPlan(a.slug)}
                          alt=""
                          width="18"
                          height="18"
                          loading="lazy"
                          class="h-4.5 w-4.5 shrink-0"
                          onerror="this.style.display='none'"
                        />
                        <Termino ref={a.ref} />
                        <span class="font-mono text-humo">{a.spent}</span>
                      </button>
                    ))}
                  </div>

                  <div class="mt-3">
                    {v.warPlan.activities.map((a, i) => {
                      const forma = layoutPlan(a.slug);
                      return (
                        <div
                          data-panel-plan={`${idBase}-${a.slug}`}
                          class:list={['grabado rounded bg-abismo p-4', i !== 0 && 'hidden']}
                        >
                          <div class="flex items-center gap-3">
                            <h3 class="font-titulo text-lg">
                              <Termino ref={a.ref} />
                            </h3>
                            <span class="ml-auto font-mono text-xs text-humo">
                              {a.spent}/{MAX_WARPLAN_POINTS} puntos
                            </span>
                          </div>
                          {/* El árbol a la izquierda y los nodos al lado: así el dibujo no
                              ocupa el ancho entero y la lista se lee sin bajar. */}
                          <div class="mt-2 gap-5 sm:flex sm:items-start">
                            {forma && (
                              <div class="mx-auto w-full max-w-xs shrink-0 sm:mx-0 sm:w-64">
                                <ArbolPlanGuerra
                                  layout={forma}
                                  invertidos={new Set(a.nodes.map((n) => n.slug))}
                                />
                              </div>
                            )}
                            <ul class="mt-3 flex-1 space-y-1.5 sm:mt-0">
                              {a.nodes.map((n) => {
                                const info = skillInfo(n.ref.enUS);
                                return (
                                  <li class="flex gap-2.5 text-sm">
                                    <span
                                      class={`mt-1.5 h-2 w-2 shrink-0 ${n.minor ? 'rotate-45 bg-oro-apagado/70' : 'rounded-full bg-brasa'}`}
                                      title={n.minor ? 'Nodo menor' : 'Nodo mayor'}
                                    />
                                    <span>
                                      <Termino ref={n.ref} clase="text-pergamino" />
                                      {info?.description && (
                                        <span class="block text-xs text-ceniza">{info.description}</span>
                                      )}
                                    </span>
                                  </li>
                                );
                              })}
                            </ul>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </>
              ) : (
                <p class="mt-2 text-ceniza">
                  Esta build no publica plan de guerra, o todavía no está extraído.
                </p>
              )}
            </section>

            {/* QUE ME FALTA */}
            <section
              data-panel-pestana="progreso"
              class="hidden grabado rounded-b-lg rounded-tr-lg bg-piedra p-5 sm:p-6"
            >
              <h2 class="font-titulo text-xl">Qué me falta para esta build</h2>
              <p class="mt-1 max-w-2xl text-sm text-ceniza">
                La lista de la compra: marca lo que ya tengas y queda a la vista lo que te queda por
                conseguir, con de dónde sale cada cosa. Se guarda en este navegador, así que puedes
                volver mañana y seguir donde lo dejaste.
              </p>
              <div class="mt-4">
                <Progreso buildId={`${build.id}:${v.source.variantIndex}`} variante={v} />
              </div>
              <p class="mt-6 max-w-2xl text-xs text-humo">
                No se envía nada a ningún servidor ni hace falta cuenta: lo marcado vive solo en tu
                equipo. Si borras los datos del navegador, se borra la lista.
              </p>
            </section>

            {/* CAMBIOS */}
            <section
              data-panel-pestana="cambios"
              class="hidden grabado rounded-b-lg rounded-tr-lg bg-piedra p-5 sm:p-6"
            >
              <h2 class="font-titulo text-xl">Qué ha cambiado en esta build</h2>
              {cambios.length > 0 ? (
                <>
                  <p class="mt-1 text-sm text-ceniza max-w-2xl">
                    Lo que el autor de la guía ha ido tocando desde que la seguimos. Útil si ya la
                    estás jugando: aquí ves si te has quedado con una versión vieja sin enterarte.
                  </p>
                  <div class="mt-4">
                    <ListaCambios entradas={cambios} limite={12} />
                  </div>
                </>
              ) : (
                <p class="mt-2 text-ceniza max-w-2xl">
                  Sin cambios desde que la seguimos ({registrandoDesde}). No es que no pase nada: es
                  que esta build no se ha tocado. Cuando su autor cambie algo, aparecerá aquí.
                </p>
              )}
              <p class="mt-6 text-xs text-humo max-w-2xl">
                Solo se listan los cambios de la guía. Cuando cambiamos algo nosotros —el extractor,
                una tanda de traducciones— se detecta porque afecta a medio catálogo a la vez y se
                deja fuera, para no apuntarle a la guía cosas que no ha hecho.
              </p>
            </section>

            {/* NOTAS */}
            <section
              data-panel-pestana="notas"
              class="hidden grabado rounded-b-lg rounded-tr-lg bg-piedra p-5 sm:p-6"
            >
              <h2 class="font-titulo text-xl">Notas del autor</h2>
              <p class="mt-2 text-sm text-ceniza max-w-2xl">
                Las notas de la build las escribe su autor, y ese texto es suyo: no lo copiamos aquí.
                Nosotros traemos los datos (equipo, habilidades, Paragón) y los traducimos; el análisis
                está en su guía original y merece la visita.
              </p>
              <a
                href={v.source.url}
                rel="nofollow noopener external"
                target="_blank"
                class="mt-4 inline-block grabado grabado-hover rounded bg-abismo px-4 py-2 text-sm"
              >
                Leer las notas en {v.source.site}
                {v.source.author && ` · ${v.source.author}`} →
              </a>
            </section>

            <footer class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 px-1 text-xs text-humo">
              <span>
                Fuente:
                <a
                  href={v.source.url}
                  rel="nofollow noopener external"
                  target="_blank"
                  class="underline underline-offset-4 hover:text-pergamino"
                >
                  {v.source.site}
                </a>
                {v.source.author && <> · {v.source.author}</>}
              </span>
              <span>Capturada el {fechaCaptura}</span>
              <span>Completitud: {Math.round(v.completeness.score * 100)}%</span>
            </footer>
          </div>
        );
      })
    }
  </div>
</Base>

<div id="tooltip" class="tooltip-panel hidden" role="tooltip"></div>

<script>
  // ---- Pestañas -------------------------------------------------------------------
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-pestana]');

  function mostrarPestana(id: string) {
    for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset['pestana'] === id));
    // Solo se tocan los paneles de la variante visible; los de las otras siguen ocultos
    // por su contenedor, así que basta con marcar todos y dejar que el padre mande.
    for (const p of document.querySelectorAll<HTMLElement>('[data-panel-pestana]')) {
      p.classList.toggle('hidden', p.dataset['panelPestana'] !== id);
    }
  }
  for (const tab of tabs) {
    tab.addEventListener('click', () => mostrarPestana(tab.dataset['pestana'] ?? ''));
  }

  // ---- Actividades del plan de guerra ---------------------------------------------
  // Pestañitas dentro de la pestaña: cada actividad tiene su árbol y su lista, y solo se
  // ve una. Los id llevan el índice de variante, así que dos variantes no se pisan.
  for (const boton of document.querySelectorAll<HTMLButtonElement>('[data-plan]')) {
    boton.addEventListener('click', () => {
      const id = boton.dataset['plan'] ?? '';
      const grupo = boton.parentElement;
      for (const b of grupo?.querySelectorAll<HTMLButtonElement>('[data-plan]') ?? []) {
        b.setAttribute('aria-selected', String(b.dataset['plan'] === id));
      }
      // Solo los paneles de esta variante: comparten el prefijo del identificador.
      const prefijo = id.slice(0, id.indexOf('-'));
      for (const p of document.querySelectorAll<HTMLElement>('[data-panel-plan]')) {
        const suyo = p.dataset['panelPlan'] ?? '';
        if (!suyo.startsWith(`${prefijo}-`)) continue;
        p.classList.toggle('hidden', suyo !== id);
      }
    });
  }

  // ---- Variantes ------------------------------------------------------------------
  const botonesVariante = document.querySelectorAll<HTMLButtonElement>('[data-variante]');
  const panelesVariante = document.querySelectorAll<HTMLElement>('[data-panel-variante]');

  function mostrarVariante(id: string, actualizarUrl = true) {
    let encontrado = false;
    for (const p of panelesVariante) {
      const visible = p.dataset['panelVariante'] === id;
      p.classList.toggle('hidden', !visible);
      if (visible) encontrado = true;
    }
    if (!encontrado) return;
    for (const b of botonesVariante) b.setAttribute('aria-selected', String(b.dataset['variante'] === id));
    if (actualizarUrl) {
      const params = new URLSearchParams(location.search);
      params.set('var', id);
      history.replaceState(null, '', `?${params}`);
    }
  }
  for (const b of botonesVariante) b.addEventListener('click', () => mostrarVariante(b.dataset['variante'] ?? ''));
  const varInicial = new URLSearchParams(location.search).get('var');
  if (varInicial) mostrarVariante(varInicial, false);

  // ---- Tooltips --------------------------------------------------------------------
  const panel = document.getElementById('tooltip')!;
  let ancladoA: HTMLElement | null = null;

  function colocar(objetivo: HTMLElement) {
    const r = objetivo.getBoundingClientRect();
    const p = panel.getBoundingClientRect();
    let x = r.left + r.width / 2 - p.width / 2;
    let y = r.top - p.height - 10;
    x = Math.max(8, Math.min(x, window.innerWidth - p.width - 8));
    if (y < 8) y = Math.min(r.bottom + 10, window.innerHeight - p.height - 8);
    panel.style.left = `${x}px`;
    panel.style.top = `${y}px`;
  }

  function abrir(objetivo: HTMLElement) {
    const plantilla = document.getElementById(objetivo.dataset['tooltip'] ?? '') as HTMLTemplateElement | null;
    if (!plantilla) return;
    panel.replaceChildren(plantilla.content.cloneNode(true));
    panel.classList.remove('hidden');
    ancladoA = objetivo;
    colocar(objetivo);
  }

  function cerrar() {
    panel.classList.add('hidden');
    ancladoA = null;
  }

  for (const el of document.querySelectorAll<HTMLElement>('[data-tooltip]')) {
    el.addEventListener('mouseenter', () => abrir(el));
    el.addEventListener('mouseleave', cerrar);
    el.addEventListener('focus', () => abrir(el));
    el.addEventListener('blur', cerrar);
    el.addEventListener('click', (e) => {
      e.preventDefault();
      if (ancladoA === el) cerrar();
      else abrir(el);
    });
  }
  window.addEventListener('scroll', () => ancladoA && colocar(ancladoA), { passive: true });
  window.addEventListener('resize', () => ancladoA && colocar(ancladoA));
  document.addEventListener('click', (e) => {
    if (ancladoA && !(e.target as HTMLElement).closest('[data-tooltip]')) cerrar();
  });
</script>
