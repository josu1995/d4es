---
import Base from '../../../layouts/Base.astro';
import Termino from '../../../components/Termino.astro';
import { loadBuilds, loadClasesEs, claseNombre } from '../../../lib/data';
import { classById, type CanonicalBuild } from '@d4es/schema';

export function getStaticPaths() {
  return loadBuilds().map((build) => ({
    params: { clase: classById(build.classId)?.slug ?? build.classId, slug: build.id },
    props: { build },
  }));
}

interface Props {
  build: CanonicalBuild;
}

const { build } = Astro.props;
const clasesEs = loadClasesEs();
const nombreClase = claseNombre(build.classId, clasesEs);

const principal = build.variants.find((v) => v.id === build.primaryVariantId) ?? build.variants[0]!;
const hayVariasFuentes = build.variants.length > 1;

const FALTA: { clave: keyof typeof principal.completeness; etiqueta: string }[] = [
  { clave: 'hasGear', etiqueta: 'equipo y aspectos' },
  { clave: 'hasParagon', etiqueta: 'tablero de Paragón y glifos' },
  { clave: 'hasTalisman', etiqueta: 'talismán (sello y amuletos)' },
  { clave: 'hasMercenary', etiqueta: 'mercenario' },
];
const queFalta = FALTA.filter((f) => principal.completeness[f.clave] === false).map((f) => f.etiqueta);

const fechaCaptura = new Date(principal.source.capturedAt).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  titulo={`${build.title.es} — ${nombreClase} · Build de Diablo 4 en español`}
  descripcion={`Build de ${nombreClase} "${build.title.es}" (${build.title.en}) para Diablo 4 temporada ${build.gameVersion.season}, traducida al castellano.`}
>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <nav aria-label="Migas de pan" class="text-xs text-humo">
      <a href="/builds" class="hover:text-pergamino">Builds</a>
      <span> / </span>
      <a href={`/builds?clase=${classById(build.classId)?.slug}`} class="hover:text-pergamino">{nombreClase}</a>
    </nav>

    <header class="mt-3">
      <h1 class="font-titulo text-3xl sm:text-4xl">{build.title.es}</h1>
      {
        build.title.es !== build.title.en && (
          <p class="mt-1 text-sm text-humo">
            En inglés: <span class="text-ceniza">{build.title.en}</span>
          </p>
        )
      }
      <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
        <span class="grabado rounded bg-piedra px-2.5 py-1">{nombreClase}</span>
        {build.ratings.tierLabel && (
          <span class="grabado rounded bg-piedra px-2.5 py-1">Tier {build.ratings.tierLabel}</span>
        )}
        {build.ratings.pitTier && (
          <span class="grabado rounded bg-piedra px-2.5 py-1">Fosa {build.ratings.pitTier}</span>
        )}
        <span class="grabado rounded bg-piedra px-2.5 py-1">
          Temporada {build.gameVersion.season} · {build.gameVersion.patch}
        </span>
      </div>
    </header>

    <!--
      El selector de fuente es la razón de ser del sitio: la misma build vista con los ojos
      de cada autor, sin fusionarlas nunca. Con una sola fuente se muestra igual, para que
      quede claro de dónde sale lo que estás leyendo.
    -->
    <section class="mt-8" aria-labelledby="h-fuentes">
      <h2 id="h-fuentes" class="text-xs uppercase tracking-wider text-humo">
        {hayVariasFuentes ? 'Elige la versión que quieres ver' : 'Fuente'}
      </h2>
      <div class="mt-2 flex flex-wrap gap-2" role="tablist">
        {
          build.variants.map((v) => (
            <button
              type="button"
              role="tab"
              data-variante={v.id}
              aria-selected={v.id === build.primaryVariantId}
              class="grabado grabado-hover rounded bg-piedra px-3 py-2 text-sm aria-selected:border-brasa/60 aria-selected:bg-brasa/15"
            >
              <span class="font-medium">{v.source.site}</span>
              {v.source.author && <span class="text-humo"> · {v.source.author}</span>}
              {v.source.variantLabel && <span class="text-humo"> · {v.source.variantLabel}</span>}
            </button>
          ))
        }
      </div>
      {
        hayVariasFuentes && (
          <a href={`${Astro.url.pathname}/comparar`} class="mt-2 inline-block text-sm text-ceniza underline underline-offset-4 hover:text-pergamino">
            Ver en qué se diferencian →
          </a>
        )
      }
    </section>

    {
      build.variants.map((v) => (
        <div data-panel={v.id} class:list={[v.id !== build.primaryVariantId && 'hidden']}>
          <section class="mt-8" aria-label="Habilidades">
            <h2 class="font-titulo text-xl">Habilidades</h2>
            {v.skills.length === 0 ? (
              <p class="mt-2 text-ceniza">Esta fuente no publica las habilidades de la build.</p>
            ) : (
              <ul class="mt-3 divide-y divide-grabado grabado rounded-lg bg-piedra overflow-hidden">
                {v.skills.map((s) => (
                  <li class="flex items-baseline gap-3 px-4 py-2.5">
                    <span class="w-10 shrink-0 text-right font-mono text-sm text-oro">{s.rank}</span>
                    <span class="min-w-0">
                      <Termino ref={s.ref} />
                      {s.skillVariant && (
                        <span class="text-sm text-humo">
                          {' — '}
                          <Termino ref={s.skillVariant} />
                        </span>
                      )}
                      {s.runes.length > 0 && (
                        <span class="mt-1 flex flex-wrap gap-1.5">
                          {s.runes.map((r) => (
                            <span class="rounded border border-grabado bg-abismo px-1.5 py-0.5 text-[0.7rem] text-ceniza">
                              <Termino ref={r} />
                            </span>
                          ))}
                        </span>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section class="mt-8 grabado rounded-lg bg-piedra p-4 text-sm">
            <h2 class="font-titulo text-lg">De dónde sale esta build</h2>
            <dl class="mt-3 grid gap-2 sm:grid-cols-2">
              <div>
                <dt class="text-humo text-xs uppercase tracking-wider">Fuente</dt>
                <dd>
                  <a
                    href={v.source.url}
                    rel="nofollow noopener external"
                    target="_blank"
                    class="text-ceniza underline underline-offset-4 hover:text-pergamino"
                  >
                    {v.source.site} — ver la guía original
                  </a>
                </dd>
              </div>
              {v.source.author && (
                <div>
                  <dt class="text-humo text-xs uppercase tracking-wider">Autor</dt>
                  <dd class="text-ceniza">{v.source.author}</dd>
                </div>
              )}
              <div>
                <dt class="text-humo text-xs uppercase tracking-wider">Última captura</dt>
                <dd class="text-ceniza">{fechaCaptura}</dd>
              </div>
              <div>
                <dt class="text-humo text-xs uppercase tracking-wider">Completitud</dt>
                <dd class="text-ceniza">{Math.round(v.completeness.score * 100)}%</dd>
              </div>
            </dl>
          </section>
        </div>
      ))
    }

    {
      queFalta.length > 0 && (
        <aside class="mt-6 grabado rounded-lg border-oro-apagado/40 bg-oro/5 p-4 text-sm">
          <p class="text-pergamino">
            <strong>Esta ficha aún no incluye {queFalta.join(', ')}.</strong>
          </p>
          <p class="mt-1.5 text-ceniza">
            El catálogo público de la fuente solo publica las habilidades. El resto se extrae de la página de
            la build, que es un paso posterior del proyecto. Mientras tanto, el enlace de arriba te lleva a
            la guía completa del autor.
          </p>
        </aside>
      )
    }
  </div>
</Base>

<script>
  // Cambio de fuente sin recargar. La URL refleja la elección para poder compartirla.
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-variante]');
  const paneles = document.querySelectorAll<HTMLElement>('[data-panel]');

  function mostrar(id: string, actualizarUrl = true) {
    let encontrado = false;
    for (const panel of paneles) {
      const visible = panel.dataset['panel'] === id;
      panel.classList.toggle('hidden', !visible);
      if (visible) encontrado = true;
    }
    if (!encontrado) return;
    for (const boton of botones) {
      boton.setAttribute('aria-selected', String(boton.dataset['variante'] === id));
    }
    if (actualizarUrl) {
      const params = new URLSearchParams(location.search);
      params.set('fuente', id);
      history.replaceState(null, '', `?${params}`);
    }
  }

  for (const boton of botones) {
    boton.addEventListener('click', () => mostrar(boton.dataset['variante'] ?? ''));
  }

  const inicial = new URLSearchParams(location.search).get('fuente');
  if (inicial) mostrar(inicial, false);
</script>
