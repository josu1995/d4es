---
import Base from '../layouts/Base.astro';
import ListaCambios from '../components/ListaCambios.astro';
import { loadIndex, loadEstado, buildUrl, loadHistorial } from '../lib/data';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { ROOT } from '../lib/data';

const indice = loadIndex();
const estado = loadEstado();

interface Ingesta {
  generatedAt: string;
  builds: number;
  eliminadas: number;
  avisos: string[];
  etiquetas: string[];
  temporadaDetectada: number | null;
  temporadaConfigurada: number;
}

const rutaIngesta = join(ROOT, 'data', 'reports', 'ingesta.json');
const ingesta: Ingesta | null = existsSync(rutaIngesta)
  ? (JSON.parse(readFileSync(rutaIngesta, 'utf8')) as Ingesta)
  : null;

const fecha = (iso: string) =>
  new Date(iso).toLocaleString('es-ES', { dateStyle: 'long', timeStyle: 'short' });

// Las builds tocadas más recientemente: es lo que de verdad cambia entre ingestas.
const recientes = [...indice.builds]
  .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt) || a.title.localeCompare(b.title))
  .slice(0, 20);

// Lo que ha cambiado DENTRO de las builds, que es lo que importa si estás jugando una.
// Solo cambios de las guías: los nuestros los aparta el generador del historial.
const historial = loadHistorial();
const filaPorId = new Map(indice.builds.map((b) => [b.id, b]));
const conCambios = Object.entries(historial?.builds ?? {})
  .map(([id, h]) => ({ id, fila: filaPorId.get(id), entradas: h.entradas.filter((e) => e.ambito === 'fuente') }))
  .filter((x) => x.fila !== undefined && x.entradas.length > 0)
  .sort((a, b) => (b.entradas[0]?.fecha ?? '').localeCompare(a.entradas[0]?.fecha ?? ''))
  .slice(0, 12);

const desdeCuando = historial
  ? new Date(historial.desde).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---

<Base
  titulo="Últimos cambios — D4es"
  descripcion="Qué ha cambiado en la web: builds actualizadas, avisos de la última ingesta automática y estado de la temporada."
  migas={[{ nombre: 'Inicio', url: '/' }, { nombre: 'Cambios', url: '/cambios' }]}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-titulo text-3xl">Últimos cambios</h1>
    <p class="mt-2 text-ceniza">
      Los datos se revisan solos cada 6 horas y solo se publican si han cambiado de verdad. Esta página
      cuenta qué pasó en la última pasada.
    </p>

    <section class="mt-8 grabado rounded-lg bg-piedra p-5">
      <h2 class="font-titulo text-xl">Última ingesta</h2>
      <dl class="mt-3 space-y-2 text-sm">
        <div class="flex gap-3">
          <dt class="w-44 shrink-0 text-humo">Cuándo</dt>
          <dd>{fecha(indice.generatedAt)}</dd>
        </div>
        <div class="flex gap-3">
          <dt class="w-44 shrink-0 text-humo">Builds publicadas</dt>
          <dd>{indice.count}</dd>
        </div>
        {
          ingesta && (
            <>
              <div class="flex gap-3">
                <dt class="w-44 shrink-0 text-humo">Retiradas del origen</dt>
                <dd>{ingesta.eliminadas}</dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-44 shrink-0 text-humo">Temporada</dt>
                <dd>
                  {ingesta.temporadaConfigurada}
                  {ingesta.temporadaDetectada && (
                    <span class="text-brasa-viva">
                      {' '}
                      — el origen ya publica la {ingesta.temporadaDetectada}: toca el corte de temporada
                    </span>
                  )}
                </dd>
              </div>
            </>
          )
        }
      </dl>

      {
        ingesta && ingesta.avisos.length > 0 && (
          <details class="mt-4">
            <summary class="cursor-pointer text-sm text-ceniza hover:text-pergamino">
              {ingesta.avisos.length} avisos de la última pasada
            </summary>
            <ul class="mt-2 space-y-1 text-xs text-humo">
              {ingesta.avisos.slice(0, 40).map((a) => (
                <li class="flex gap-2">
                  <span>·</span>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </section>

    {
      historial && (
        <section class="mt-6">
          <h2 class="font-titulo text-xl">Qué ha cambiado dentro de las builds</h2>
          <p class="mt-1 text-sm text-ceniza">
            No solo qué builds se han tocado: qué han cambiado exactamente sus autores. Se registra
            desde el {desdeCuando}, y llevamos {historial.pasadas}{' '}
            {historial.pasadas === 1 ? 'pasada' : 'pasadas'}.
          </p>

          {conCambios.length > 0 ? (
            <div class="mt-4 space-y-4">
              {conCambios.map((x) => (
                <article class="grabado rounded-lg bg-piedra p-4">
                  <h3 class="font-titulo text-lg">
                    <a href={buildUrl(x.fila!)} class="hover:text-brasa-viva">
                      {x.fila!.title}
                    </a>
                  </h3>
                  <div class="mt-2">
                    <ListaCambios entradas={x.entradas} limite={3} />
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="mt-4 grabado rounded-lg bg-piedra p-4 text-sm text-ceniza">
              Todavía ninguna guía ha cambiado desde que se registra. Es lo normal al principio:
              esta lista se llena sola conforme sus autores las vayan tocando.
            </p>
          )}
        </section>
      )
    }

    <section class="mt-6">
      <h2 class="font-titulo text-xl">Builds actualizadas</h2>
      <ul class="mt-3 grabado rounded-lg bg-piedra divide-y divide-grabado overflow-hidden">
        {
          recientes.map((b) => (
            <li class="flex flex-wrap items-baseline gap-x-3 px-4 py-2.5">
              <a href={buildUrl(b)} class="text-pergamino hover:text-brasa-viva">
                {b.title}
              </a>
              {b.tierLabel && <span class="text-xs text-oro">Tier {b.tierLabel}</span>}
              <span class="ml-auto text-xs text-humo">
                {new Date(b.updatedAt).toLocaleDateString('es-ES')}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mt-8 text-sm text-ceniza">
      ¿Prefieres que te llegue solo? Hay <a href="/rss.xml" class="underline underline-offset-4">feed RSS</a>.
      El estado completo de los datos, con sus lagunas, está en
      <a href="/estado" class="underline underline-offset-4">Estado de los datos</a>.
    </p>
  </div>
</Base>
