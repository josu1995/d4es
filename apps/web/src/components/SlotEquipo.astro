---
import type { GearItem } from '@d4es/schema';
import { iconoUnico, iconoRanura, iconoCodex, codexDeIcono, COLOR_CALIDAD, CODEX_ES } from '../lib/iconos';
import { NOMBRE_SLOT, CALIDAD_ES, capitalizar } from '../lib/etiquetas';
import { loadDiccionario } from '../lib/data';

/**
 * Una pieza de equipo, con el mismo reparto de informacion que el planificador de
 * d4builds: icono, nombre coloreado por calidad, aspecto, afijos con marca de superior
 * y de templado, y engarces. El detalle largo va al tooltip.
 *
 * Las piezas legendarias no tienen objeto base con nombre (solo su aspecto), asi que su
 * previsualizacion es el icono generico de la ranura —el "pantalon basico", como en
 * maxroll— mas la categoria del codice del aspecto (ofensivo/defensivo/utilidad), que es
 * la imagen con que la propia fuente las pinta.
 */
interface Props {
  item: GearItem;
  idTooltip: string;
  /** A la derecha se alinea al reves, como el muneco del juego. */
  derecha?: boolean;
}

const { item, idTooltip, derecha = false } = Astro.props;
const dict = loadDiccionario();

const principal = item.item ?? item.aspect;
const nombre = principal ? (principal.esES ?? principal.enUS) : 'Vacío';
const sinTraducir = principal ? principal.esES === null : false;
const colorNombre = item.mythic.isMythic ? 'text-rareza-mitico' : (COLOR_CALIDAD[item.quality] ?? 'text-rareza-normal');

// Los unicos y miticos tienen su propia imagen; el resto usa el icono generico de la
// ranura, como hacen d4builds y maxroll, para que ninguna pieza salga vacia.
const icono = item.item ? iconoUnico(item.item.enUS) : iconoRanura(item.slot);
const esGenerico = item.item === null;

// La categoria del codice sale de la imagen que publica la fuente (Codex/1/offensive.png).
const categoriaCodex = codexDeIcono(item.icon);

// Descripcion del poder del unico o del aspecto, en castellano, para el tooltip.
const claveDesc = item.item
  ? `unique:${item.item.idName}`
  : item.aspect
    ? `aspect:${item.aspect.idName}`
    : null;
const descripcion = claveDesc ? (dict.byIdName[claveDesc]?.desc ?? null) : null;

const etiquetaSlot = NOMBRE_SLOT[item.slot] ?? item.slot;
const etiquetaCalidad = item.mythic.isMythic ? 'Mítico' : (CALIDAD_ES[item.quality] ?? item.quality);
---

<div class:list={['flex items-start gap-3', derecha && 'flex-row-reverse text-right']}>
  <button
    type="button"
    class="slot-equipo relative block h-14 w-14 shrink-0 rounded bg-piedra-alta"
    data-tooltip={idTooltip}
    aria-describedby={idTooltip}
  >
    {
      icono && (
        <img
          src={icono}
          alt=""
          width="56"
          height="56"
          loading="lazy"
          class:list={['h-full w-full rounded object-cover', esGenerico && 'opacity-80']}
          onerror="this.style.display='none'"
        />
      )
    }
    {
      categoriaCodex && (
        <img
          src={iconoCodex(categoriaCodex)}
          alt=""
          width="20"
          height="20"
          loading="lazy"
          title={`Categoría del códice: ${CODEX_ES[categoriaCodex]}`}
          class:list={[
            'absolute -top-1.5 h-5 w-5 rounded-full border border-grabado-vivo bg-abismo p-0.5',
            derecha ? 'right-0' : 'left-0',
          ]}
          onerror="this.style.display='none'"
        />
      )
    }
    {
      item.sockets.length > 0 && (
        <span class:list={['absolute -bottom-1 flex gap-0.5', derecha ? 'left-0' : 'right-0']}>
          {item.sockets.map((s) => (
            <span
              class="h-2.5 w-2.5 rotate-45 border border-oro-apagado/70 bg-abismo"
              title={s.esES ?? s.enUS}
            />
          ))}
        </span>
      )
    }
  </button>

  <div class="min-w-0 flex-1">
    <p class="text-[0.65rem] uppercase tracking-wider text-humo">{etiquetaSlot}</p>
    <p class={`text-sm leading-tight ${colorNombre}`}>
      {nombre}
      {sinTraducir && <span class="chip-en" data-i18n-missing>EN</span>}
      {item.mythic.isMythic && <span class="ml-1 text-[0.6rem] uppercase tracking-wider">mítico</span>}
    </p>
    {
      item.affixes.length > 0 && (
        <ul class:list={['mt-1 space-y-0.5', derecha && 'flex flex-col items-end']}>
          {item.affixes.slice(0, 4).map((a) => (
            <li class="text-[0.7rem] leading-tight text-ceniza">
              {a.greater && <span class="text-oro" title="Afijo superior">★ </span>}
              <span class={a.tempered ? 'text-rareza-magico' : ''}>
                {capitalizar(a.ref.esES ?? a.ref.enUS)}
              </span>
              {a.ref.esES === null && <span class="chip-en" data-i18n-missing>EN</span>}
              {a.tempered && <span class="text-humo" title="Afijo templado"> ⚒</span>}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>

<template id={idTooltip}>
  <div class="tt-titulo">{nombre}</div>
  <div class="tt-meta">
    <span>{etiquetaSlot}</span>
    <span>{etiquetaCalidad}</span>
    {categoriaCodex && <span>{CODEX_ES[categoriaCodex]}</span>}
  </div>
  {
    icono && (
      <img
        src={icono}
        alt=""
        width="72"
        height="72"
        class="mt-2 h-18 w-18 rounded border border-grabado-vivo bg-piedra-alta object-cover"
      />
    )
  }
  {descripcion && <p class="tt-descripcion">{descripcion}</p>}
  {
    item.affixes.length > 0 && (
      <div class="tt-runas">
        {item.affixes.map((a) => (
          <div>
            <span class="tt-runa-nombre">
              {a.greater ? '★' : '·'} {capitalizar(a.ref.esES ?? a.ref.enUS)}
            </span>
            {a.ref.esES === null && <span class="chip-en">EN</span>}
            {a.tempered && <span class="tt-runa-desc"> (templado)</span>}
          </div>
        ))}
      </div>
    )
  }
  {
    item.sockets.length > 0 && (
      <div class="tt-runas">
        {item.sockets.map((s) => (
          <div>
            <span class="tt-runa-nombre">◆ {s.esES ?? s.enUS}</span>
            {s.esES === null && <span class="chip-en">EN</span>}
          </div>
        ))}
      </div>
    )
  }
</template>

<style>
  .slot-equipo {
    border: 1px solid var(--color-grabado-vivo);
    box-shadow: inset 0 0 10px rgb(0 0 0 / 0.6);
    transition:
      border-color 120ms ease,
      transform 120ms ease;
  }
  .slot-equipo:hover,
  .slot-equipo:focus-visible {
    border-color: var(--color-oro-apagado);
    transform: scale(1.05);
  }
</style>
