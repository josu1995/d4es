---
import type { BuildIndexRow } from '@d4es/schema';
import { buildUrl } from '../lib/data';
import { iconoClase, iconoSkillPorSlug } from '../lib/iconos';

interface Props {
  build: BuildIndexRow;
  claseEs: string;
}

const { build, claseEs } = Astro.props;

const COLOR_TIER: Record<string, string> = {
  S: 'text-rareza-mitico border-rareza-mitico/50 bg-rareza-mitico/10',
  A: 'text-rareza-legendario border-rareza-legendario/50 bg-rareza-legendario/10',
  B: 'text-rareza-raro border-rareza-raro/40 bg-rareza-raro/10',
  C: 'text-rareza-magico border-rareza-magico/40 bg-rareza-magico/10',
};
const tierClase = build.tierLabel ? (COLOR_TIER[build.tierLabel[0] ?? ''] ?? '') : '';

// Como en las tarjetas de d4builds: una fila con los iconos de las habilidades.
const iconos = build.skillIcons.slice(0, 6).map((slug, i) => ({
  src: iconoSkillPorSlug(slug),
  alt: build.skills[i] ?? '',
}));
---

<article
  class="grabado grabado-hover rounded-lg bg-piedra h-full flex flex-col overflow-hidden"
  data-build
  data-clase={build.classSlug}
  data-contenido={build.content.join(' ')}
  data-fuentes={build.sources.join(' ')}
  data-pit={build.pitTier ?? 0}
  data-tier={build.tierLabel ?? ''}
  data-busqueda={`${build.title} ${build.titleEn} ${claseEs} ${build.authors.join(' ')} ${build.skills.join(' ')}`.toLowerCase()}
>
  <a href={buildUrl(build)} class="flex items-center gap-3 p-4 pb-3">
    <img
      src={iconoClase(build.classId)}
      alt=""
      width="44"
      height="44"
      loading="lazy"
      class="h-11 w-11 shrink-0 rounded border border-grabado-vivo bg-abismo object-cover"
      onerror="this.style.visibility='hidden'"
    />
    <div class="min-w-0 flex-1">
      <h3 class="font-titulo text-lg leading-tight truncate hover:text-brasa-viva transition-colors">
        {build.title}
      </h3>
      <p class="text-xs text-humo mt-0.5 truncate">
        {claseEs}
        {build.authors.length > 0 && <span> · {build.authors.join(', ')}</span>}
      </p>
    </div>
    {
      build.tierLabel && (
        <span
          class={`shrink-0 rounded border px-2 py-0.5 text-xs font-semibold ${tierClase}`}
          title="Posición en la tier list de la fuente"
        >
          {build.tierLabel}
        </span>
      )
    }
  </a>

  {
    iconos.length > 0 && (
      <div class="flex gap-1.5 px-4">
        {iconos.map((ic) => (
          <img
            src={ic.src}
            alt={ic.alt}
            title={ic.alt}
            width="34"
            height="34"
            loading="lazy"
            class="h-[34px] w-[34px] rounded-full border border-grabado bg-abismo object-cover"
            onerror="this.style.display='none'"
          />
        ))}
      </div>
    )
  }

  <div class="mt-auto flex items-center gap-3 p-4 pt-3 text-xs text-humo">
    {build.pitTier ? <span title="Nivel de Fosa que aguanta según la fuente">Fosa {build.pitTier}</span> : null}
    <span>{build.content.includes('leveling') ? 'Subida de nivel' : 'Endgame'}</span>
    <span class="ml-auto flex gap-1">
      {build.sources.map((s) => <span class="rounded border border-grabado px-1.5 py-0.5">{s}</span>)}
    </span>
  </div>
</article>
