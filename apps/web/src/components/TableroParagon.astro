---
import type { ParagonBoardLayout } from '@d4es/schema';
import { iconoCasillaParagon } from '../lib/iconos';

/**
 * Un tablero de Paragón dibujado entero, con el camino de la build encendido.
 *
 * La fuente lo pinta en su web con CSS (una rejilla de botones r/c girada con
 * `transform: rotate(...)`); aquí se dibuja en SVG con el mismo patrón que
 * `ArbolPlanGuerra.astro`: la forma sale del catálogo compartido
 * (`paragon-boards-dataset.json`, una vez por clase + tablero) y la build solo aporta
 * qué casillas recorre y con qué giro monta el tablero.
 *
 * El giro se aplica TRANSFORMANDO las coordenadas (fila, columna), no con un rotate del
 * SVG: así el dibujo queda girado como en el juego pero los iconos quedan derechos.
 *
 * Cada casilla lleva su icono, como en d4builds y maxroll. Son ~160 por tablero y hasta
 * 9 tableros por ficha, así que NO se emite una <image> por casilla: se declara una vez
 * por tipo en <defs> y cada casilla es un <use>, que el navegador dibuja sin volver a
 * descargar nada. Las casillas recorridas usan la variante encendida del icono, que es
 * como las pinta el juego.
 */
interface Props {
  layout: ParagonBoardLayout;
  /** Giro con que esta build monta el tablero (dato de la build, no de la forma). */
  rotation: 0 | 90 | 180 | 270 | null;
  /** Casillas que la build recorre, compactas ("r2c11"), en la rejilla SIN girar. */
  tiles: Set<string>;
  /** Nombre del glifo engarzado (para el título de la casilla del glifo). */
  glifo?: string | null;
  /** Sufijo para los id de <defs>: han de ser únicos en toda la página. */
  idBase: string;
}

const { layout, rotation, tiles, glifo = null, idBase } = Astro.props;

/** Lado de una casilla y hueco entre ellas, en unidades del viewBox. */
const LADO = 22;
const HUECO = 4;
const PASO = LADO + HUECO;

const rot = rotation ?? 0;
const { rows, cols } = layout;

/** Gira (fila, col) de la rejilla lógica a la rejilla dibujada, en sentido horario. */
function girar(row: number, col: number): { r: number; c: number } {
  if (rot === 90) return { r: col, c: rows + 1 - row };
  if (rot === 180) return { r: rows + 1 - row, c: cols + 1 - col };
  if (rot === 270) return { r: cols + 1 - col, c: row };
  return { r: row, c: col };
}

const dibujadas = layout.tiles.map((t) => {
  const { r, c } = girar(t.row, t.col);
  const activa = tiles.has(`r${t.row}c${t.col}`);
  return {
    ...t,
    activa,
    esGlifo: t.type === 'Glyph',
    x: (c - 1) * PASO,
    y: (r - 1) * PASO,
  };
});

// Un símbolo por combinación (tipo, encendida) de las que se usan de verdad.
const simbolos = new Map<string, { tipo: string; activa: boolean; id: string }>();
for (const t of dibujadas) {
  if (!t.type) continue;
  const clave = `${t.type}|${t.activa}`;
  if (simbolos.has(clave)) continue;
  simbolos.set(clave, {
    tipo: t.type,
    activa: t.activa,
    id: `p-${idBase}-${t.type.replace(/[^A-Za-z0-9]/g, '')}-${t.activa ? 'on' : 'off'}`,
  });
}
const idDe = (tipo: string, activa: boolean) => simbolos.get(`${tipo}|${activa}`)?.id ?? null;

const anchoRejilla = (rot === 90 || rot === 270 ? rows : cols) * PASO - HUECO;
const altoRejilla = (rot === 90 || rot === 270 ? cols : rows) * PASO - HUECO;

const COLOR_RAREZA: Record<string, string> = {
  common: 'var(--color-grabado-vivo)',
  magic: 'var(--color-rareza-magico)',
  rare: 'var(--color-rareza-raro)',
  legendary: 'var(--color-rareza-legendario)',
};

const RAREZA_ES: Record<string, string> = {
  common: 'común',
  magic: 'mágica',
  rare: 'rara',
  legendary: 'legendaria',
};

function tituloDe(t: (typeof dibujadas)[number]): string {
  if (t.esGlifo) return glifo ? `Engarce de glifo: ${glifo}` : 'Engarce de glifo';
  const rareza = t.rarity ? ` (casilla ${RAREZA_ES[t.rarity] ?? t.rarity})` : '';
  return `${t.type}${rareza}${t.activa ? '' : ' — no recorrida'}`;
}
---

<figure class="mt-3">
  <svg
    viewBox={`${-HUECO} ${-HUECO} ${anchoRejilla + HUECO * 2} ${altoRejilla + HUECO * 2}`}
    class="mx-auto h-auto w-full max-w-md"
    role="img"
    aria-label={`Tablero de Paragón ${layout.name}`}
  >
    <defs>
      {
        [...simbolos.values()].map((s) => (
          <image
            id={s.id}
            href={iconoCasillaParagon(s.tipo, s.activa)}
            width={LADO - 6}
            height={LADO - 6}
          />
        ))
      }
    </defs>

    {
      dibujadas.map((t) => {
        const borde = t.activa
          ? 'var(--color-brasa-viva)'
          : (COLOR_RAREZA[t.rarity ?? 'common'] ?? 'var(--color-grabado-vivo)');
        const relleno = t.activa ? 'rgb(200 69 47 / 0.35)' : 'var(--color-piedra)';
        const cx = t.x + LADO / 2;
        const cy = t.y + LADO / 2;
        const icono = t.type ? idDe(t.type, t.activa) : null;
        return (
          <g opacity={t.activa ? '1' : '0.5'}>
            <title>{tituloDe(t)}</title>
            {t.esGlifo ? (
              <rect
                x={t.x + 2}
                y={t.y + 2}
                width={LADO - 4}
                height={LADO - 4}
                rx="3"
                transform={`rotate(45 ${cx} ${cy})`}
                fill={t.activa ? 'rgb(201 162 39 / 0.35)' : 'var(--color-piedra)'}
                stroke={t.activa ? 'var(--color-oro)' : 'var(--color-oro-apagado)'}
                stroke-width="2.5"
              />
            ) : (
              <rect
                x={t.x}
                y={t.y}
                width={LADO}
                height={LADO}
                rx="3"
                fill={relleno}
                stroke={borde}
                stroke-width={t.rarity && t.rarity !== 'common' ? 2.5 : 1.5}
              />
            )}
            {icono && <use href={`#${icono}`} x={t.x + 3} y={t.y + 3} />}
          </g>
        );
      })
    }
  </svg>
</figure>
